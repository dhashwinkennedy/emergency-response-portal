NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/emergency_response
SESSION_SECRET=replace_with_a_long_random_secret_at_least_32_characters
SESSION_NAME=emergency.sid
SESSION_MAX_AGE_DAYS=7
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
UPLOAD_DIR=./uploads
GEOAPIFY_API_KEY=your_geoapify_api_key
GEOAPIFY_BASE_URL=https://api.geoapify.com/v1
GEOAPIFY_DEFAULT_LANGUAGE=en
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=your_nvidia_nemotron_model_identifier
OPENROUTER_HTTP_REFERER=http://localhost:5173
OPENROUTER_APP_NAME=Emergency Response Platform
OPENROUTER_TIMEOUT_MS=30000
OPENROUTER_MAX_RETRIES=1
OPENROUTER_MAX_OUTPUT_TOKENS=1500
AI_ENABLED=true
DUPLICATE_SEARCH_RADIUS_METERS=5000
DUPLICATE_TIME_WINDOW_HOURS=24
DUPLICATE_CANDIDATE_LIMIT=10
DUPLICATE_MIN_SCORE=55
HOTSPOT_RADIUS_METERS=1000
HOTSPOT_MIN_INCIDENTS=3
HOTSPOT_MAX_INCIDENTS=10000
TEAM_LOCATION_STALE_MS=300000
LOG_LEVEL=info
INITIAL_ADMIN_NAME=System Administrator
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=replace_with_a_secure_password
